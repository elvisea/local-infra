# Credenciais de DEV. Senha verdadeira em prod fica no ansible-vault.
# Copie para .env (gitignored) e ajuste se quiser.

# PostgreSQL — superuser (apps usam users dedicados criados pelo init SQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Valkey
VALKEY_PASSWORD=valkey_dev

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev

# ClickHouse (base CNPJ — dev do prospec_etl)
# HTTP em 127.0.0.1:8123, nativo em 127.0.0.1:9100 (9000 é do MinIO)
CLICKHOUSE_DB=cnpj
CLICKHOUSE_USER=prospec_etl
CLICKHOUSE_PASSWORD=clickhouse_dev
